<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#eeefef"
    tools:context=".MainActivity">


    <ImageView
        android:id="@+id/navbarabdl"
        android:layout_width="413dp"
        android:layout_height="72dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/detailbanner" />

    <Button
        android:id="@+id/chatabdl"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_marginTop="-10dp"
        android:backgroundTint="#fb8500"
        android:text="Chat Sekarang"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/kotakabdl" />

    <ImageView
        android:id="@+id/kotakabdl"
        android:layout_width="wrap_content"
        android:layout_height="350dp"
        android:layout_marginTop="220dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navbarabdl"
        app:srcCompat="@drawable/navbarmontir__1_" />

    <TextView
        android:id="@+id/Surabaya"
        android:layout_width="95dp"
        android:layout_height="32dp"
        android:layout_marginStart="139dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="171dp"
        android:text="Surabaya"
        android:textColor="#023047"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/namaabdl" />

    <TextView
        android:id="@+id/customerabdl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:text="7.200 Customer sudah melakukan chat"
        android:textColor="#023047"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hargaabdl" />

    <TextView
        android:id="@+id/hargaabdl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="-10dp"
        android:text="Rp.300.000"
        android:textColor="#fb8500"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bulatabdl" />

    <TextView
        android:id="@+id/namaabdl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="100dp"
        android:text="Abdul Suprapto - Bodywork Specialist"
        android:textColor="#000"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/kotakabdl" />

    <ImageView
        android:id="@+id/logoabdl"
        android:layout_width="83dp"
        android:layout_height="48dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toEndOf="@+id/backabdl"
        app:layout_constraintTop_toTopOf="@+id/navbarabdl"
        app:srcCompat="@drawable/logotext" />

    <ImageView
        android:id="@+id/backabdl"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="19dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/navbarabdl"
        app:srcCompat="@android:drawable/ic_menu_revert" />

    <ImageView
        android:id="@+id/bulatabdl"
        android:layout_width="127dp"
        android:layout_height="91dp"
        android:layout_marginStart="7dp"
        android:layout_marginTop="-12dp"
        android:layout_marginEnd="200dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/namaabdl"
        app:srcCompat="@drawable/bulatanmontir" />

    <ImageView
        android:id="@+id/suitcaseabdl"
        android:layout_width="27dp"
        android:layout_height="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="360dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bulatabdl"
        app:srcCompat="@drawable/likesuitcasemontir" />

    <TextView
        android:id="@+id/tahunabdl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="53dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="295dp"
        android:text="9+ Tahun"
        android:textColor="#eeee"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bulatabdl" />

    <ImageView
        android:id="@+id/fotoabdul"
        android:layout_width="315dp"
        android:layout_height="298dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navbarabdl"
        app:srcCompat="@drawable/montir2" />

</androidx.constraintlayout.widget.ConstraintLayout>